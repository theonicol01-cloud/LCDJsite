# La Cuisine de Jeanine — configuration Apache (Hostinger)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# HTTPS + domaine sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://lacuisinedejeanine.fr%{REQUEST_URI} [L,R=301]

# Anciennes adresses -> nouvelles (garde le référencement acquis)
RewriteRule ^Accueil(\.dc)?\.html$ / [L,R=301,NC]
RewriteRule ^Solutions(\.dc)?\.html$ /frigo-connecte/ [L,R=301,NC]
RewriteRule ^A-Propos(\.dc)?\.html$ /notre-histoire/ [L,R=301,NC]
RewriteRule ^Contact(\.dc)?\.html$ /#devis [L,R=301,NC,NE]
RewriteRule ^Mentions-Legales(\.dc)?\.html$ /mentions-legales/ [L,R=301,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'sha256-REPLACE'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
<FilesMatch "\.(webp|jpg|png|svg|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
